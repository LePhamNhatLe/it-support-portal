NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://127.0.0.1:5500

# Keep memory for zero-setup local development. Switch to mysql after adding database credentials.
DATA_SOURCE=memory
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=it_support_portal
DB_SSL=true
# Local development can read the CA certificate from a file path.
DB_CA_PATH=server/certs/ca.pem
# Hosted environments can provide the PEM certificate directly instead of committing a file.
DB_CA_CERT=
DB_CONNECTION_LIMIT=4

# Backend JWT authentication. Use a long random secret outside development.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
