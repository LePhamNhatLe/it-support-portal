NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://127.0.0.1:5500

# Keep memory for zero-setup local development. Switch to mysql after adding cloud credentials.
DATA_SOURCE=memory
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=it_support_portal
DB_SSL=true
DB_CA_PATH=server/certs/ca.pem
DB_CONNECTION_LIMIT=4

# P24 backend authentication. Use a long random value outside development.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
